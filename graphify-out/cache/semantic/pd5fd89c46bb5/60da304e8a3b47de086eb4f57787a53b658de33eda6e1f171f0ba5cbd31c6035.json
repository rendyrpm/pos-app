{"nodes": [{"id": "CLAUDE.md_pos_application", "label": "POS Application", "file_type": "concept", "source_file": "CLAUDE.md"}, {"id": "CLAUDE.md_ui_ux_guidelines", "label": "UI/UX Guidelines", "file_type": "document", "source_file": "CLAUDE.md", "rationale": "Prioritize cashier ease of use, consistency, visual hierarchy, responsive design across all pages. Avoid generic CRUD admin template appearance."}, {"id": "CLAUDE.md_pos_design_principles", "label": "POS Design Principles", "file_type": "rationale", "source_file": "CLAUDE.md", "rationale": "POS page must be optimized for fast cashier use. Minimize clicks to complete a transaction. Cart always visible. Total payment must be prominent. 'Bayar' (Pay) is primary action."}, {"id": "CLAUDE.md_ux_loading_states", "label": "Loading States and Skeleton Loading", "file_type": "concept", "source_file": "CLAUDE.md", "rationale": "Use loading state and skeleton loading for perceived performance. Empty states must be informative."}, {"id": "CLAUDE.md_ux_feedback_patterns", "label": "UX Feedback Patterns", "file_type": "concept", "source_file": "CLAUDE.md", "rationale": "Use confirmation dialogs for dangerous actions, toast notifications for feedback, clear form validation, and user-friendly error messages."}, {"id": "CLAUDE.md_technology_stack", "label": "Technology Stack", "file_type": "concept", "source_file": "CLAUDE.md"}, {"id": "CLAUDE.md_docker_architecture", "label": "Docker Architecture Requirements", "file_type": "document", "source_file": "CLAUDE.md", "rationale": "Application must run via Docker Compose. Minimum containers: Laravel/PHP, Web server, MySQL. Architecture must be extensible for Redis, Queue Worker, Scheduler, Mail Service."}, {"id": "CLAUDE.md_server_security", "label": "Server Security Rules", "file_type": "document", "source_file": "CLAUDE.md"}, {"id": "CLAUDE.md_project_structure", "label": "Project Structure", "file_type": "document", "source_file": "CLAUDE.md"}, {"id": "CLAUDE.md_authentication_